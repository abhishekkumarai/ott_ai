# Generate the real .env with:  python backend/scripts/make_env.py
# (reads the machine DATABASE_URL and appends the ott_ai_db database name)
OTT_ENV=dev
OTT_DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5432/ott_ai_db
OTT_DOCKER_DATABASE_URL=postgresql+asyncpg://postgres:<password>@host.docker.internal:5432/ott_ai_db
OTT_JWT_SECRET=<48+ random characters>
OTT_YOUTUBE_API_KEY=<YouTube Data API v3 key, restricted to youtube.googleapis.com>
OTT_OLLAMA_URL=http://localhost:11434
OTT_DOCKER_OLLAMA_URL=http://host.docker.internal:11434
# Optional: TMDB title search for movie/TV sources (either one works; plain TMDB_API_KEY /
# TMDB_READ_ACCESS_TOKEN in the environment are picked up too)
OTT_TMDB_API_KEY=
OTT_TMDB_READ_TOKEN=
